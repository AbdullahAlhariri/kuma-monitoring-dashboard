# -----------------------------------------------------------------------------
# MIRROR DASHBOARD CONFIGURATION (.env.example)
# -----------------------------------------------------------------------------

# Weather Configuration (Open-Meteo API — no API key required)
WEATHER_ENABLED=true
WEATHER_LAT=51.5714
WEATHER_LON=4.6366
WEATHER_TIMEZONE=Europe/Amsterdam
NEXT_PUBLIC_WEATHER_LABEL=Rotterdam
# Shown in the tiny strip above the clock; defaults to the browser's timezone
NEXT_PUBLIC_WEATHER_TIMEZONE=Europe/Amsterdam

# Mawaqit Prayer Times
MAWAQIT_ENABLED=true
# Fallback only — a mosque set in dashboard.config.json wins
MAWAQIT_URL=https://mawaqit.net/XX/XXXX

# Beaver Habits Integration
BEAVER_ENABLED=true
BEAVER_BASE_URL=https://xxxxx.xx
BEAVER_TOKEN=XXXXXX
BEAVER_REFETCH_INTERVAL_MS=10000
# Weeks shown by the GitHub-style contribution graph
BEAVER_CONTRIBUTION_WEEKS=52

# Uptime Kuma Monitoring
KUMA_ENABLED=true
KUMA_BASE_URL=http://localhost:3001
KUMA_SLUG=public

# Runtime state written by the dashboard itself (mosque, habit colours, week offset)
DASHBOARD_CONFIG_PATH=dashboard.config.json

# Clock / UI Locales
NEXT_PUBLIC_CLOCK_LOCALE=en-US
# School weeks come from the TU/e calendar table in src/lib/academicCalendar.ts
# (transcribed from the official PDF) — edit that file for a new academic year
