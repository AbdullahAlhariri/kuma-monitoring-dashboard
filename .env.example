# Weather (Open-Meteo — no API key required)
# Coordinates for the location you want weather for
WEATHER_LAT=52.3676
WEATHER_LON=4.9041
# IANA timezone name — must match the coordinates
WEATHER_TIMEZONE=Europe/Amsterdam
# Label shown in the dashboard UI (client-side, must have NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_WEATHER_LABEL=Amsterdam

# Uptime Kuma
# Base URL of your Uptime Kuma instance (no trailing slash)
KUMA_BASE_URL=https://your-kuma.example.com
# Status page slug (the part after /status/ in your Kuma URL)
KUMA_SLUG=public

# Clock / date formatting
# BCP-47 locale tag used for the date string below the clock
NEXT_PUBLIC_CLOCK_LOCALE=en-US
