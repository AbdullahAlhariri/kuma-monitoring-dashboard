# -----------------------------------------------------------------------------
# MIRROR DASHBOARD CONFIGURATION (.env.example)
# -----------------------------------------------------------------------------

# Weather Configuration (Open-Meteo API — no API key required)
WEATHER_ENABLED=true
WEATHER_LAT=51.5714
WEATHER_LON=4.6366
WEATHER_TIMEZONE=Europe/Amsterdam
NEXT_PUBLIC_WEATHER_LABEL=Rotterdam

# Mawaqit Prayer Times
MAWAQIT_ENABLED=true
MAWAQIT_URL=https://mawaqit.net/XX/XXXX
MAWAQIT_CONFIG_PATH=mawaqit-config.json

# Beaver Habits Integration
BEAVER_ENABLED=true
BEAVER_BASE_URL=https://xxxxx.xx
BEAVER_TOKEN=XXXXXX
BEAVER_REFETCH_INTERVAL_MS=10000

# Uptime Kuma Monitoring
KUMA_ENABLED=true
KUMA_BASE_URL=http://localhost:3001
KUMA_SLUG=public

# Clock / UI Locales
NEXT_PUBLIC_CLOCK_LOCALE=en-US
